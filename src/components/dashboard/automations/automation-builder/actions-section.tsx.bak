import { Badge } from "@/components/ui/badge";
import { Button } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import {
  FormControl,
  FormField,
  FormItem,
  FormLabel,
} from "@/components/ui/form";
import { Input } from "@/components/ui/input";
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select";
import { Switch } from "@/components/ui/switch";
import { Textarea } from "@/components/ui/textarea";
import { cn } from "@/lib/utils";
import {
  ArrowDown,
  Bot,
  Brain,
  FileText,
  Mail,
  MessageSquare,
  Pencil,
  Plus,
  Sparkles,
  Trash2,
  Wand2,
} from "lucide-react";
import { useCallback, useMemo, useState } from "react";
import { useFieldArray } from "react-hook-form";

interface ActionsSectionProps {
  form: any;
  automationType?: "email" | "job" | "schedule";
}

export default function ActionsSection({
  form,
  automationType,
}: ActionsSectionProps) {
  // Use field array to handle dynamic actions
  const { fields, append, remove } = useFieldArray({
    control: form.control,
    name: "actions",
  });

  const [tempActionType, setTempActionType] = useState<string>("send_email");

  // Filter action types based on automation type - only keep send_email and ai_follow_up
  const getActionsByType = () => {
    const allActions = [
      {
        type: "send_email",
        label: "Send Email",
        description: "Send an email using a template with delay options",
        icon: <Mail className="h-5 w-5" />,
        category: ["email", "job", "schedule"],
        color: "text-blue-500",
        bgColor: "bg-blue-100",
        gradient: "from-blue-50 to-indigo-100",
        textColor: "text-blue-700",
      },
      {
        type: "ai_follow_up",
        label: "AI Follow-up",
        description: "Generate personalized AI-powered follow-up messages",
        icon: <Brain className="h-5 w-5" />,
        category: ["email"],
        color: "text-violet-500",
        bgColor: "bg-violet-100",
        gradient: "from-purple-50 to-violet-100",
        textColor: "text-violet-700",
      },
    ];

    if (!automationType) {
      return allActions;
    }

    return allActions.filter((action) =>
      action.category.includes(automationType)
    );
  };

  const actionTypes = useMemo(() => getActionsByType(), [automationType]);

  // Add a new action based on the temp action type
  const addAction = useCallback(
    (e?: React.MouseEvent) => {
      // Prevent default form submission if this is triggered by a button
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }

      // Create specific default config based on action type
      let config = {};

      if (tempActionType === "send_email") {
        config = {
          templateId: "",
          delay: { value: 0, unit: "days" },
          timezone: "UTC",
        };
      } else if (tempActionType === "ai_follow_up") {
        config = {
          tone: "professional",
          length: "medium",
          includeQuestions: true,
          personalize: true,
          customInstructions: "",
          reviewBeforeSend: true,
          delay: { value: 1, unit: "days" },
        };
      }

      append({
        type: tempActionType,
        config,
      });
    },
    [append, tempActionType]
  );

  // Type assertion for field to avoid type errors
  interface ActionField {
    id: string;
    type: string;
    config?: Record<string, any>;
  }

  return (
    <div className="space-y-4">
      {fields.length === 0 ? (
        <div className="rounded-lg overflow-hidden">
          <div className="relative bg-gradient-to-r from-blue-50 to-purple-50 p-4 text-center flex flex-col items-center">
            <div className="absolute top-0 left-0 w-full h-full">
              <div className="absolute top-10 left-10 w-24 h-24 rounded-full bg-purple-200 opacity-20 blur-3xl"></div>
              <div className="absolute bottom-10 right-10 w-24 h-24 rounded-full bg-blue-200 opacity-20 blur-3xl"></div>
            </div>
            
            <div className="mb-3 relative">
              <div className="w-14 h-14 rounded-full bg-gradient-to-br from-blue-100 to-purple-200 flex items-center justify-center shadow-md shadow-blue-100/30">
                <Sparkles className="h-7 w-7 text-indigo-500 animate-pulse-slow" />
              </div>
            </div>
            
            <h3 className="text-base font-semibold text-gray-800 mb-2 relative">
              Create Your First Action
            </h3>
            <p className="text-sm text-gray-600 mb-4 max-w-md relative">
              Actions define what happens when your automation runs. Choose from the options below.
            </p>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-3 w-full max-w-xl relative">
              {actionTypes.map((action) => (
                <div 
                  key={action.type}
                  onClick={(e) => {
                    setTempActionType(action.type);
                    addAction(e);
                  }}
                  className={cn(
                    `bg-gradient-to-br ${action.gradient} border border-gray-100 p-3 rounded-lg cursor-pointer`,
                    "transform transition-all duration-300 hover:shadow-md hover:scale-[1.01] group"
                  )}
                >
                  <div className="flex items-start">
                    <div className={cn("p-1.5 rounded-full mr-3", action.bgColor)}>
                      <div className={action.color}>{action.icon}</div>
                    </div>
                    <div>
                      <h4 className={cn("font-medium text-base mb-0.5 flex items-center gap-1.5", action.textColor)}>
                        {action.label}
                        <Plus className="h-3.5 w-3.5 opacity-0 group-hover:opacity-100 transition-opacity" />
                      </h4>
                      <p className="text-xs text-gray-600">
                        {action.description}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      ) : (
        <div>
          <div className="relative">
            {fields.length > 1 && (
              <div className="absolute left-7 top-0 bottom-0 w-0.5 bg-gradient-to-b from-blue-300 via-indigo-300 to-purple-300 rounded-full z-0"></div>
            )}
            <div className="space-y-3 relative z-10">
              {fields.map((field, index) => {
                // Add type assertion for the field
                const typedField = field as unknown as ActionField;
                const actionType =
                  actionTypes.find((a) => a.type === typedField.type) ||
                  actionTypes[0];

                return (
                  <div key={field.id} className="relative">
                    {index > 0 && (
                      <div className="absolute -top-2 left-7 transform -translate-x-1/2 flex flex-col items-center">
                        <div className="h-4 w-4 rounded-full bg-gradient-to-r from-blue-200 to-purple-200 flex items-center justify-center">
                          <ArrowDown className="h-2 w-2 text-indigo-600" />
                        </div>
                        <p className="text-xs text-gray-500 mt-0.5">then</p>
                      </div>
                    )}

                    <Card
                      className={cn(
                        "group border border-gray-200 transition-all duration-300",
                        "hover:border-blue-200 hover:shadow-sm hover:shadow-blue-100/30",
                        typedField.type === "send_email" ? "bg-gradient-to-br from-white to-blue-50/70" : "bg-gradient-to-br from-white to-purple-50/70"
                      )}
                    >
                      <CardContent className="p-3">
                        <div className="flex items-start">
                          <div className={cn(
                            "flex items-center justify-center w-10 h-10 rounded-lg mr-3",
                            "bg-gradient-to-br",
                            typedField.type === "send_email" 
                              ? "from-blue-100 to-blue-200/70" 
                              : "from-violet-100 to-purple-200/70"
                          )}>
                            <div className={typedField.type === "send_email" ? "text-blue-600" : "text-violet-600"}>
                              {actionType.icon}
                            </div>
                          </div>

                          <div className="flex-1">
                            <div className="flex items-center justify-between mb-2">
                              <div>
                                <div className="flex items-center gap-1.5">
                                  <h4 className={cn(
                                    "font-medium text-sm",
                                    typedField.type === "send_email" ? "text-blue-700" : "text-violet-700"
                                  )}>
                                    {actionType.label}
                                  </h4>
                                  <Badge variant="outline" className={cn(
                                    "text-xs py-0 px-1.5",
                                    typedField.type === "send_email" 
                                      ? "text-blue-500 border-blue-200 bg-blue-50" 
                                      : "text-violet-500 border-violet-200 bg-violet-50"
                                  )}>
                                    {index === 0 ? "First" : `Step ${index + 1}`}
                                  </Badge>
                                </div>
                                <p className="text-xs text-gray-500 mt-0.5">
                                  {actionType.description}
                                </p>
                              </div>

                              <Button
                                type="button"
                                size="sm"
                                variant="ghost"
                                onClick={(e) => {
                                  e.preventDefault();
                                  remove(index);
                                }}
                                className="h-6 w-6 p-0 opacity-70 hover:opacity-100 hover:bg-red-50 hover:text-red-500 rounded-full"
                              >
                                <Trash2 className="h-3 w-3" />
                              </Button>
                            </div>

                            {/* Action-specific configuration fields */}
                            <div className={cn(
                              "mt-2 p-2 rounded-lg border",
                              typedField.type === "send_email" 
                                ? "bg-blue-50/40 border-blue-100" 
                                : "bg-purple-50/40 border-purple-100"
                            )}>
                              {typedField.type === "send_email" && (
                                <div className="space-y-3">
                                  <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                                    <FormField
                                      control={form.control}
                                      name={`actions.${index}.config.templateId`}
                                      render={({ field: configField }) => (
                                        <FormItem>
                                          <FormLabel className="text-xs font-medium text-gray-700 flex items-center gap-1.5">
                                            <FileText className="h-3 w-3 text-blue-500" />
                                            Email Template
                                          </FormLabel>
                                  <Select
                                    onValueChange={configField.onChange}
                                    defaultValue={configField.value}
                                  >
                                    <FormControl>
                                      <SelectTrigger className="h-8 text-xs bg-white border-blue-200 focus:ring-blue-500">
                                        <SelectValue placeholder="Select template" />
                                      </SelectTrigger>
                                    </FormControl>
                                    <SelectContent>
                                      <SelectItem value="welcome">
                                        Welcome Email
                                      </SelectItem>
                                      <SelectItem value="interview-invite">
                                        Interview Invitation
                                      </SelectItem>
                                      <SelectItem value="rejection">
                                        Rejection Email
                                      </SelectItem>
                                      <SelectItem value="offer">
                                        Job Offer
                                      </SelectItem>
                                    </SelectContent>
                                  </Select>
                                </FormItem>
                              )}
                            />
                          </div>
                          
                          <div className="bg-white p-2.5 rounded-md border border-blue-100">
                            <h5 className="text-xs font-medium text-gray-700 mb-2">Sending Options</h5>
                            <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
                              <FormField
                                control={form.control}
                                name={`actions.${index}.config.delay.value`}
                                render={({ field: configField }) => (
                                  <FormItem className="col-span-1">
                                    <FormLabel className="text-xs font-medium text-gray-600">
                                      Delay
                                    </FormLabel>
                                    <FormControl>
                                      <Input
                                        type="number"
                                        {...configField}
                                        min="0"
                                        className="h-7 text-xs bg-white border-gray-200"
                                      />
                                    </FormControl>
                                  </FormItem>
                                )}
                              />

                              <FormField
                                control={form.control}
                                name={`actions.${index}.config.delay.unit`}
                                render={({ field: configField }) => (
                                  <FormItem className="col-span-1">
                                    <FormLabel className="text-xs font-medium text-gray-600">
                                      Unit
                                    </FormLabel>
                                    <Select
                                      onValueChange={configField.onChange}
                                      defaultValue={configField.value}
                                    >
                                      <FormControl>
                                        <SelectTrigger className="h-7 text-xs bg-white border-gray-200">
                                          <SelectValue placeholder="Unit" />
                                        </SelectTrigger>
                                      </FormControl>
                                      <SelectContent>
                                        <SelectItem value="minutes">
                                          Minutes
                                        </SelectItem>
                                        <SelectItem value="hours">
                                          Hours
                                        </SelectItem>
                                        <SelectItem value="days">
                                          Days
                                        </SelectItem>
                                        <SelectItem value="weeks">
                                          Weeks
                                        </SelectItem>
                                      </SelectContent>
                                    </Select>
                                  </FormItem>
                                )}
                              />
                              
                              <FormField
                                control={form.control}
                                name={`actions.${index}.config.timezone`}
                                render={({ field: configField }) => (
                                  <FormItem className="col-span-1">
                                    <FormLabel className="text-xs font-medium text-gray-600">
                                      Timezone
                                    </FormLabel>
                                    <Select
                                      onValueChange={configField.onChange}
                                      defaultValue={configField.value}
                                    >
                                      <FormControl>
                                        <SelectTrigger className="h-7 text-xs bg-white border-gray-200">
                                          <SelectValue placeholder="Select timezone" />
                                        </SelectTrigger>
                                      </FormControl>
                                      <SelectContent>
                                        <SelectItem value="UTC">UTC</SelectItem>
                                        <SelectItem value="America/New_York">Eastern</SelectItem>
                                        <SelectItem value="America/Chicago">Central</SelectItem>
                                        <SelectItem value="America/Denver">Mountain</SelectItem>
                                        <SelectItem value="America/Los_Angeles">Pacific</SelectItem>
                                      </SelectContent>
                                    </Select>
                                  </FormItem>
                                )}
                              />
                            </div>
                          </div>
                        </div>
                      )}

                      {typedField.type === "ai_follow_up" && (
                        <div className="space-y-3">
                          <div className="flex items-center bg-violet-50 border border-violet-100 rounded-md p-2 mb-3">
                            <Wand2 className="h-4 w-4 text-violet-600 mr-2" />
                            <div>
                              <h5 className="text-xs font-medium text-violet-700">AI-powered follow-up messages</h5>
                              <p className="text-xs text-violet-600 opacity-80">Our AI will analyze candidate data and create personalized follow-ups</p>
                            </div>
                          </div>
                          
                          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <FormField
                              control={form.control}
                              name={`actions.${index}.config.tone`}
                              render={({ field: configField }) => (
                                <FormItem>
                                  <FormLabel className="text-xs font-medium text-gray-700 flex items-center gap-1.5">
                                    <MessageSquare className="h-3 w-3 text-violet-500" />
                                    Communication Tone
                                  </FormLabel>
                                  <Select
                                    onValueChange={configField.onChange}
                                    defaultValue={configField.value || "professional"}
                                  >
                                    <FormControl>
                                      <SelectTrigger className="h-7 text-xs bg-white border-violet-200 focus:ring-violet-500">
                                        <SelectValue placeholder="Select tone" />
                                      </SelectTrigger>
                                    </FormControl>
                                    <SelectContent>
                                      <SelectItem value="professional">Professional</SelectItem>
                                      <SelectItem value="friendly">Friendly</SelectItem>
                                      <SelectItem value="casual">Casual</SelectItem>
                                      <SelectItem value="formal">Formal</SelectItem>
                                    </SelectContent>
                                  </Select>
                                </FormItem>
                              )}
                            />

                            <FormField
                              control={form.control}
                              name={`actions.${index}.config.length`}
                              render={({ field: configField }) => (
                                <FormItem>
                                  <FormLabel className="text-xs font-medium text-gray-700 flex items-center gap-1.5">
                                    <FileText className="h-3 w-3 text-violet-500" />
                                    Message Length
                                  </FormLabel>
                                  <Select
                                    onValueChange={configField.onChange}
                                    defaultValue={configField.value || "medium"}
                                  >
                                    <FormControl>
                                      <SelectTrigger className="h-7 text-xs bg-white border-violet-200 focus:ring-violet-500">
                                        <SelectValue placeholder="Select length" />
                                      </SelectTrigger>
                                    </FormControl>
                                    <SelectContent>
                                      <SelectItem value="brief">Brief (1-2 paragraphs)</SelectItem>
                                      <SelectItem value="medium">Medium (2-3 paragraphs)</SelectItem>
                                      <SelectItem value="detailed">Detailed (3+ paragraphs)</SelectItem>
                                    </SelectContent>
                                  </Select>
                                </FormItem>
                              )}
                            />
                          </div>

                          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
                            <div className="bg-white p-2.5 rounded-md border border-violet-100 space-y-2">
                              <h5 className="text-xs font-medium text-gray-700">Content Options</h5>
                              
                              <FormField
                                control={form.control}
                                name={`actions.${index}.config.includeQuestions`}
                                render={({ field: configField }) => (
                                  <FormItem className="flex items-center justify-between space-y-0">
                                    <div>
                                      <FormLabel className="text-xs text-gray-600">Include Questions</FormLabel>
                                      <p className="text-xs text-gray-500 opacity-80">Add questions to engage candidate</p>
                                    </div>
                                    <FormControl>
                                      <Switch
                                        checked={configField.value}
                                        onCheckedChange={configField.onChange}
                                      />
                                    </FormControl>
                                  </FormItem>
                                )}
                              />
                              
                              <FormField
                                control={form.control}
                                name={`actions.${index}.config.personalize`}
                                render={({ field: configField }) => (
                                  <FormItem className="flex items-center justify-between space-y-0">
                                    <div>
                                      <FormLabel className="text-xs text-gray-600">Personalize Content</FormLabel>
                                      <p className="text-xs text-gray-500 opacity-80">Reference candidate's background</p>
                                    </div>
                                    <FormControl>
                                      <Switch
                                        checked={configField.value}
                                        onCheckedChange={configField.onChange}
                                      />
                                    </FormControl>
                                  </FormItem>
                                )}
                              />
                            </div>
                            
                            <FormField
                              control={form.control}
                              name={`actions.${index}.config.customInstructions`}
                              render={({ field: configField }) => (
                                <FormItem>
                                  <FormLabel className="text-xs font-medium text-gray-700 flex items-center gap-1.5">
                                    <Pencil className="h-3 w-3 text-violet-500" />
                                    Custom Instructions
                                  </FormLabel>
                                  <FormControl>
                                    <Textarea 
                                      placeholder="E.g., Always mention our company values"
                                      className="resize-none h-[75px] text-xs bg-white border-violet-200 focus:ring-violet-500"
                                      {...configField}
                                    />
                                  </FormControl>
                                </FormItem>
                              )}
                            />
                          </div>

                          <div className="bg-white p-2.5 rounded-md border border-violet-100">
                            <h5 className="text-xs font-medium text-gray-700 mb-2">Sending Options</h5>
                            <div className="space-y-3">
                              <FormField
                                control={form.control}
                                name={`actions.${index}.config.reviewBeforeSend`}
                                render={({ field: configField }) => (
                                  <FormItem className="flex items-center justify-between space-y-0">
                                    <div>
                                      <FormLabel className="text-xs text-gray-600">Review Before Sending</FormLabel>
                                      <p className="text-xs text-gray-500 opacity-80">Preview and edit before sending</p>
                                    </div>
                                    <FormControl>
                                      <Switch
                                        checked={configField.value}
                                        onCheckedChange={configField.onChange}
                                      />
                                    </FormControl>
                                  </FormItem>
                                )}
                              />
                              
                              <div className="grid grid-cols-2 gap-3">
                                <FormField
                                  control={form.control}
                                  name={`actions.${index}.config.delay.value`}
                                  render={({ field: configField }) => (
                                    <FormItem className="col-span-1">
                                      <FormLabel className="text-xs font-medium text-gray-600">
                                        Delay
                                      </FormLabel>
                                      <FormControl>
                                        <Input
                                          type="number"
                                          {...configField}
                                          min="0"
                                          className="h-7 text-xs bg-white border-gray-200"
                                        />
                                      </FormControl>
                                    </FormItem>
                                  )}
                                />

                                <FormField
                                  control={form.control}
                                  name={`actions.${index}.config.delay.unit`}
                                  render={({ field: configField }) => (
                                    <FormItem className="col-span-1">
                                      <FormLabel className="text-xs font-medium text-gray-600">
                                        Unit
                                      </FormLabel>
                                      <Select
                                        onValueChange={configField.onChange}
                                        defaultValue={configField.value || "days"}
                                      >
                                        <FormControl>
                                          <SelectTrigger className="h-7 text-xs bg-white border-gray-200">
                                            <SelectValue placeholder="Unit" />
                                          </SelectTrigger>
                                        </FormControl>
                                        <SelectContent>
                                          <SelectItem value="hours">Hours</SelectItem>
                                          <SelectItem value="days">Days</SelectItem>
                                          <SelectItem value="weeks">Weeks</SelectItem>
                                        </SelectContent>
                                      </Select>
                                    </FormItem>
                                  )}
                                />
                              </div>
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </CardContent>
              </Card>
            </div>
          );
        })}
      </div>

      <div className="flex justify-center mt-4">
        <div className="inline-flex rounded-md p-0.5 bg-gray-100">
          {actionTypes.map((action) => (
            <button
              key={action.type}
              type="button"
              onClick={() => setTempActionType(action.type)}
              className={cn(
                "py-1 px-2 text-xs font-medium flex items-center gap-1 rounded-md transition-all",
                tempActionType === action.type
                  ? action.type === "send_email"
                    ? "bg-white text-blue-600 shadow-sm"
                    : "bg-white text-violet-600 shadow-sm"
                  : "text-gray-600 hover:text-gray-900"
              )}
            >
              <div className={action.type === "send_email" ? "text-blue-500" : "text-violet-500"}>
                {action.icon}
              </div>
              {action.label}
            </button>
          ))}
        </div>
      </div>

      <div className="flex justify-center mt-3">
        <Button
          type="button"
          onClick={(e) => addAction(e)}
          className={cn(
            "h-7 px-3 gap-1.5 text-xs shadow-md transition-all duration-300 transform hover:scale-[1.01]",
            tempActionType === "send_email" 
              ? "bg-blue-600 hover:bg-blue-700 text-white shadow-blue-500/20"
              : "bg-violet-600 hover:bg-violet-700 text-white shadow-violet-500/20"
          )}
        >
          <Plus className="h-3 w-3" />
          Add {tempActionType === "send_email" ? "Email Action" : "AI Follow-up"}
        </Button>
      </div>

      <div className="mt-4 px-3 py-2 bg-gradient-to-r from-gray-50 to-slate-100 border border-slate-200 rounded-md">
        <div className="flex items-start">
          <div className="mr-2 mt-0.5 p-1 bg-blue-50 border border-blue-100 rounded-full">
            <Bot className="h-3 w-3 text-blue-500" />
          </div>
          <div>
            <h4 className="text-xs font-medium text-gray-800 mb-0.5">
              How Actions Work
            </h4>
            <p className="text-[11px] text-gray-600 leading-relaxed">
              Actions are executed in sequence from top to bottom. You can add multiple actions of the same type.
              Each action will only run when all conditions are met and the trigger event occurs.
            </p>
          </div>
        </div>
      </div>
    </div>
  );
}
